  "enums": {
    "PressingState": {
      "index": 0,
      "doc": " Whether the run sells, over every currency at once. The lifecycle runs\n `Scheduled → Active → Paused → Active`: a pressing opens itself at its scheduled\n start, then the artist stops and starts it at will.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop",
        "Store"
      ],
      "type_parameters": [],
      "variants": {
        "Scheduled": {
          "index": 0,
          "doc": " Opens the moment the clock passes `start_timestamp_ms` (Unix ms), with no\n further action from anyone. A start already in the past sells now.\n\n This is a *transitional* state: the first sale past the start rewrites it to\n `Active` (in `mint_next`, before any sales logic), so a run reads `Scheduled`\n only while it is still waiting. Between the start and that first sale the run\n already sells — `is_selling` answers against the clock — so nobody has to go\n first for the Pressing to be open.\n\n Consequence worth knowing: once the transition fires the start time is gone\n from the object. `PressingOpenedEvent` and `PressingStateChangedEvent` carry\n it, so \"when was this run scheduled for\" is an event-log question, not an\n object read.",
          "fields": {
            "positional_fields": false,
            "fields": {
              "start_timestamp_ms": {
                "index": 0,
                "doc": null,
                "type_": "u64"
              }
            }
          }
        },
        "Active": {
          "index": 1,
          "doc": " Selling, subject to each listing's own state.",
          "fields": {
            "positional_fields": false,
            "fields": {}
          }
        },
        "Paused": {
          "index": 2,
          "doc": " Selling in no currency, whatever the listings say.",
          "fields": {
            "positional_fields": false,
            "fields": {}
          }
        }
      }
    }
  }
