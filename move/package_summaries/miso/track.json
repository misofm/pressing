  "enums": {
    "TrackState": {
      "index": 0,
      "doc": " Lifecycle state of a track within a release. A track is born `Unassigned`,\n carrying the target `release_id` its originating `Deal` committed to (the\n release id is a digest of the whole tracklist, so this is the recording\n owner's consent to the exact release configuration). At publish the release\n verifies the match and transitions the track to `Assigned`, which carries\n no id — shedding the 32-byte commitment once it has served its purpose.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop",
        "Store"
      ],
      "type_parameters": [],
      "variants": {
        "Unassigned": {
          "index": 0,
          "doc": " Track has been created but not yet assigned to a release. Carries the\n target release id the originating deal committed to.",
