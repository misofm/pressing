{
  "id": {
    "address": "miso",
    "name": "track"
  },
  "doc": " Represents a track on a release, linking a recording to its position\n in the tracklist.\n\n A `Track` is the minimal positioned (recording, revenue-share) pair:\n - `recording_id` — the routing target for the track's revenue, and the\n   handle through which all other metadata (title, cover art, and the\n   recording/composition share-type identities) is reached.\n - `split_bps` — this track's share of the release's revenue; genuinely\n   release-specific and not derivable from the recording.\n - `state` — the assign-once lifecycle that carries (then sheds) each deal's\n   target release commitment; see `TrackState`.\n\n `Track` is intentionally monomorphic: a `Release` holds a `vector<Track>`\n of tracks from many different recordings/compositions, so it cannot be\n generic over their share types. It stores no title, cover art, or\n share-type — all derived from the recording via `recording_id`.",
  "immediate_dependencies": [
    {
      "address": "0x93b3b214ad031ef9c340543eeafccac74d6a9232ce9506751fbeccea850a0823",
      "name": "bps"
    },
    {
      "address": "miso",
      "name": "deal"
    },
    {
      "address": "miso",
      "name": "recording"
    },
    {
      "address": "sui",
      "name": "object"
    }
  ],
  "attributes": [],
  "functions": {
    "new": {
      "source_index": 0,
      "index": 0,
      "doc": " Creates a new track by accepting a deal. The deal is the authorization —\n created by the recording's admin, carrying the target release and the agreed\n split. Emits a `DealAcceptedEvent`.\n\n The deal's `RecordingShare`/`CompositionShare` phantoms are erased here: a\n `Track` is monomorphic so it can live in a release's heterogeneous\n `vector<Track>`. Identity rides on those phantoms up to this point, but the\n monomorphic `Track` must store the recording's *address* for revenue routing\n — and an address can't come from a phantom. So the matching `Recording` is\n passed in (the deal's phantoms force it to be the right one) purely to read\n its id; the deal no longer stores it.",
      "attributes": [],
      "visibility": "Public",
      "entry": false,
      "type_parameters": [
