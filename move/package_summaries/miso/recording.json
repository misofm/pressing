    "RecordingPublishedEvent": {
      "index": 3,
      "doc": " Emitted once when a recording is published. A pure pointer: it carries the\n recording's identity, with the parent composition encoded as the\n `CompositionShare` phantom. A recording's embedded fields are immutable after\n publishing, so an indexer treats this as a signal to fetch the full object by\n `recording_id`; all indexed data — including the publish timestamp — lives in\n the object itself. Dynamic fields (e.g. masters attached by ingesters,\n credits attached by the credits extension) may still change afterward.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop"
      ],
      "type_parameters": [
        {
          "phantom": true,
          "name": "RecordingShare",
          "constraints": []
        },
        {
          "phantom": true,
          "name": "CompositionShare",
          "constraints": []
        }
      ],
      "fields": {
