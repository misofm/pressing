        "fields": {
          "recording_id": {
            "index": 0,
            "doc": null,
            "type_": {
              "Datatype": {
                "module": {
                  "address": "sui",
                  "name": "object"
                },
                "name": "ID",
                "type_arguments": []
              }
            }
          }
        }
      }
    },
    "CompositionSharesGrantedEvent": {
      "index": 4,
      "doc": " Emitted when a recording grants the composition its royalty-rate worth of\n recording shares at creation. The composition's cut is settled as cap-table\n ownership — `send_funds`ed to the composition's address — so its claim on\n recording revenue is enforced by share ownership, not by any revenue\n distributor choosing to honor a rate. The rate is not stored on the\n recording: this event (in the creation transaction's effects) is its\n canonical record. What the composition owner then does with the shares\n (hold, stake, sell) is outside the protocol's scope. Both parties are\n identified by the event's phantom type parameters — `RecordingShare` for the\n granting recording, `CompositionShare` for the receiving composition — so the\n payload carries no object ids.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop"
      ],
      "type_parameters": [
        {
          "phantom": true,
          "name": "RecordingShare",
          "constraints": []
        },
        {
          "phantom": true,
          "name": "CompositionShare",
          "constraints": []
        }
      ],
      "fields": {
        "positional_fields": false,
        "fields": {
          "value": {
            "index": 0,
            "doc": " Recording-share base units granted to the composition.",
            "type_": "u64"
          },
          "rate_bps": {
            "index": 1,
            "doc": " The composition royalty rate applied at creation, in basis points.",
            "type_": "u16"
          }
        }
      }
    }
  },
