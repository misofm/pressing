    "RecordingAdminCap": {
      "index": 1,
      "doc": " Capability that authorizes modifications to a specific recording.\n Initialized when a recording is registered and transferred to the owner.\n Address is derived from the recording for client-side discoverability.\n\n Parameterized only by `RecordingShare` (not `CompositionShare`): the share\n type already uniquely identifies the recording, and the cap authorizes\n recording-scoped operations that have no bearing on the parent composition.\n Keeping it single-param stops the composition identity from contaminating\n every place a cap is held or passed.",
      "attributes": [],
      "abilities": [
        "Key",
        "Store"
      ],
      "type_parameters": [
        {
          "phantom": true,
          "name": "RecordingShare",
          "constraints": []
        }
      ],
      "fields": {
        "positional_fields": false,
        "fields": {
          "id": {
            "index": 0,
            "doc": " Unique identifier for this capability.",
            "type_": {
              "Datatype": {
                "module": {
                  "address": "sui",
                  "name": "object"
                },
                "name": "UID",
                "type_arguments": []
              }
            }
          }
        }
      }
    },
