    "CompositionRoyaltyRate": {
      "index": 2,
      "doc": " The royalty rate paired with the epoch in which it was last set.\n A rate change requires a full epoch to have elapsed since the last change —\n a rate set in epoch N is changeable from epoch N+2 onward — so every rate\n is in effect for at least one complete epoch. This bounds how a rate change\n can surprise a recording creator and makes bait-and-revert oscillation\n uneconomical: once a change lands, it is pinned in full public view for the\n remainder of that epoch plus the entire next one.",
      "attributes": [],
      "abilities": [
        "Copy",
        "Drop",
        "Store"
      ],
