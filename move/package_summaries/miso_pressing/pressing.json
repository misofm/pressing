    "verify_record": {
      "source_index": 19,
      "index": 19,
      "doc": " Whether `record` is genuinely the copy its certificate claims it is, checked from\n chain state alone and without needing the `Pressing` object.\n\n Two independent bindings must agree: the certificate must have been stamped on\n *this* record (`certificate::is_for`, the guard against a certificate moved by a\n third-party extension through the record's open `uid_mut`), and the record must sit\n at exactly the address its number derives to off its release's pressing. The\n certificate is the readable form of what the address already proves.",
      "attributes": [],
      "visibility": "Public",
      "entry": false,
      "type_parameters": [],
      "parameters": [
